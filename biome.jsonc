{
  "$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
  "extends": ["ultracite/biome/next"],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*",
      "!**/node_modules",
      "!**/build",
      "!**/dist",
      "!**/.next",
      "!**/.sst",
      "!**/*.d.ts",
      "!**/.open-next",
      "!**/bun.lock",
      "!**/package-lock.json",
      "!**/yarn.lock",
      "!**/memory-bank",
      "!**/*.lock",
      "!**/sst-env.d.ts",
      "!**/*.css",
      "!lh-template",
      "!**/pnpm-lock.yaml"
    ]
  },
  "overrides": [
    {
      "includes": ["sst.config.ts", "infra/**/*"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["**/components/ui/**/*"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off"
          },
          "performance": {
            "noBarrelFile": "off",
            "noNamespaceImport": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["**/components/ai-elements/**/*"],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
